# Runtime
PORT=5000
NODE_ENV=development

# Required
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/munmai
JWT_SECRET=replace-with-a-long-random-secret

# Public app URLs
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173
SERVER_URL=http://localhost:5000

# Deployment/runtime behavior
FORCE_HTTPS=false
REQUEST_BODY_LIMIT=2mb
UPLOAD_LIMIT_MB=5
UPLOAD_DIR=./uploads
RECEIPT_UPLOAD_DAILY_LIMIT=3
RECEIPT_UPLOAD_WEEKLY_LIMIT=15
RECEIPT_UPLOAD_MAX_SIZE_MB=10
ALLOW_LOCALHOST_EMAIL_LINKS=true

# SMTP is required for registration email verification.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Munmai <no-reply@example.com>
